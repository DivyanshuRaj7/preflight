{
  "name": "preflight-application-compiler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx scripts/run-evaluation.ts",
    "eval:ocr": "tsx scripts/ocr-harness.ts",
    "dev": "vite",
      "build": "vite build",
      "build:server": "esbuild src/server/prod-server.ts --bundle --platform=node --format=esm --outfile=dist-server/prod-server.mjs --external:@playwright/test --log-level=warning",
      "start": "node dist-server/prod-server.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:headed": "playwright test --headed",
      "demo:reset": "tsx scripts/demo-reset.ts",
      "demo:browser": "tsx scripts/demo-browser.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
