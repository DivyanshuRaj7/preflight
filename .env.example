# Optional live semantic inference. Copy to .env (never commit
# credentials) or export directly. Everything runs WITHOUT these set, using
# the deterministic semantic provider. Model availability and pricing change
# over time; the identifier below is the current test target, not a free-tier
# promise — OPENROUTER_MODEL stays configurable.
#
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# SEMANTIC_PROVIDER: deterministic | openrouter | gemini (default: deterministic)
# SEMANTIC_PROVIDER=deterministic
# SEMANTIC_SEND_IMAGE: true | false (default: false) — attach document image
#   to live semantic requests when supported by the selected provider.
# SEMANTIC_SEND_IMAGE=false
